{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "eslint/no-unused-vars": [
      "warn",
      {
        "varsIgnorePattern": "^(?:_|isNineMangaLanguage$)",
        "argsIgnorePattern": "^_"
      }
    ]
  },
  "overrides": [
    {
      "files": ["scripts/finalize-comic-readers.mjs"],
      "rules": {
        "eslint/no-useless-escape": "off"
      }
    }
  ]
}
